[Unit]
Description=D&D Beyond Importer Proxy Server

[Container]
Pod=foundryvtt.pod
ContainerName=ddb-proxy
Image=ghcr.io/mrprimate/ddb-proxy:latest
AutoUpdate=registry

Environment=VIRTUAL_HOST=ddb-proxy.renkin42.dev
Environment=VIRTUAL_PORT=443

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
