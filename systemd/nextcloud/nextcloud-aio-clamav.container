[Unit]
Description=Nextcloud AIO ClamAV Anti Virus

[Container]
Pod=nextcloud.pod
ContainerName=nextcloud-aio-clamav
Image=ghcr.io/nextcloud-releases/aio-clamav:latest
AutoUpdate=registry
User=100
RunInit=true

HealthCmd=/healthcheck.sh
HealthStartPeriod=60s
HealthStartupInterval=5s
HealthInterval=30s
HealthTimeout=30s
HealthRetries=3

Environment=AIO_LOG_LEVEL=warn
Environment=TZ=America/Los_Angeles
Environment=MAX_SIZE=1G

Volume=nextcloud-aio-clamav.volume:/var/lib/clamav:rw,Z
ReadOnly=true
Tmpfs=/run
Tmpfs=/tmp
Tmpfs=/var/log/clamav

[Service]
Restart=always
TimeoutStartSec=900
