[Unit]
Description=Nextcloud Main Container
After=nextcloud-aio-database.container
After=nextcloud-aio-redis.container
After=nextcloud-aio-clamav.container
After=nextcloud-aio-fulltextsearch.container
After=nextcloud-aio-imaginary.container

[Container]
Pod=nextcloud.pod
ContainerName=nextcloud-aio-nextcloud
Image=ghcr.io/nextcloud-releases/aio-nextcloud:latest
AutoUpdate=registry
RunInit=true
StopTimeout=600

HealthCmd=/healthcheck.sh
HealthStartPeriod=0s
HealthStartupInterval=5s
HealthInterval=30s
HealthTimeout=30s
HealthRetries=3

Environment=NEXTCLOUD_HOST=localhost
Environment=POSTGRES_HOST=localhost
Environment=POSTGRES_PORT=5432
Secret=nextcloud-aio-postgres-password,type=env,target=POSTGRES_PASSWORD
Environment=POSTGRES_DB=nextcloud_database
Environment=POSTGRES_USER=nextcloud
Environment=REDIS_HOST=localhost
Environment=REDIS_PORT=6379
Secret=nextcloud-aio-redis-password,type=env,target=REDIS_HOST_PASSWORD
Environment=APACHE_HOST=localhost
Environment=APACHE_PORT=11000
Environment=NC_DOMAIN=cloud.wedomad.science
Environment=ADMIN_USER=admin
Secret=nextcloud-aio-admin-password,type=env,target=ADMIN_PASSWORD
Environment=NEXTCLOUD_DATA_DIR=/mnt/ncdata
Environment=OVERWRITEHOST=cloud.wedomad.science
Environment=OVERWRITEPROTOCOL=https
Secret=nextcloud-aio-turn-secret,type=env,target=TURN_SECRET
Secret=nextcloud-aio-signaling-secret,type=env,target=SIGNALING_SECRET
Secret=nextcloud-aio-eurooffice-secret,type=env,target=EUROOFFICE_SECRET
Environment=AIO_LOG_LEVEL=warn
Environment=NEXTCLOUD_MOUNT=/mnt/
Environment=CLAMAV_ENABLED="yes"
Environment=CLAMAV_HOST=localhost
Environment=ONLYOFFICE_ENABLED="no"
Environment=EUROOFFICE_ENABLED="yes"
Environment=COLLABORA_ENABLED="no"
Environment=TALK_ENABLED="yes"
Environment=EUROOFFICE_HOST=localhost
Environment=UPDATE_NEXTCLOUD_APPS="no"
Environment=TZ=America/Los_Angeles
Environment=TALK_PORT=3478
Environment=IMAGINARY_ENABLED="yes"
Environment=IMAGINARY_HOST=localhost
Environment=PHP_UPLOAD_LIMIT=1G
Environment=PHP_MEMORY_LIMIT=512M
Environment=FULLTEXTSEARCH_ENABLED="yes"
Environment=FULLTEXTSEARCH_HOST=localhost
Environment=FULLTEXTSEARCH_PROTOCOL=http
Environment=FULLTEXTSEARCH_PORT=9200
Environment=FULLTEXTSEARCH_USER=elastic
Environment=FULLTEXTSEARCH_INDEX=nextcloud-aio
Environment=PHP_MAX_TIME=3600
Environment=TRUSTED_CACERTS_DIR=/usr/local/share/ca-certificates/my-custom-ca
Environment=STARTUP_APPS="deck twofactor_totp tasks calendar contacts notes"
Environment=ADDITIONAL_APKS=imagemagick
Environment=ADDITIONAL_PHP_EXTENSIONS=imagick
Environment=INSTALL_LATEST_MAJOR="no"
Environment=TALK_RECORDING_ENABLED="no"
Secret=nextcloud-aio-fulltextsearch-password,type=env,target=FULLTEXTSEARCH_PASSWORD
Environment=REMOVE_DISABLED_APPS="no"
Secret=nextcloud-aio-imaginary-secret,type=env,target=IMAGINARY_SECRET
Environment=WHITEBOARD_ENABLED="no"
Environment=HARP_ENABLED="no"

Volume=nextcloud-aio-nextcloud.volume:/var/www/html:rw,Z
Volume=nextcloud-aio-nextcloud-data.volume:/mnt/ncdata:rw,Z
Volume=/var/mnt/:/mnt/:rw,z
Volume=/usr/local/share/ca-certificates/my-custom-ca:/usr/local/share/ca-certificates:ro,z
ShmSize=134217728

[Service]
Restart=always
TimeoutStartSec=900
