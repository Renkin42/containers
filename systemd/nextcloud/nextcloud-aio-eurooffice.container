[Unit]
Description=Nextcloud AIO EuroOffice Server

[Container]
Pod=nexcloud.pod
ContainerName=nextcloud-aio-eurooffice
Image=ghcr.io/nextcloud-releases/aio-eurooffice:latest
AutoUpdate=registry
RunInit=true

HealthCmd=/healthcheck.sh
HealthStartPeriod=60s
HealthStartupInterval=5s
HealthInterval=30s
HealthTimeout=30s
HealthRetries=3

Environment=AIO_LOG_LEVEL=warn
Environment=LOG_LEVEL=warn
Environment=TZ=America/Los_Angeles
Environment=JWT_ENABLED=true
Environment=JWT_HEADER=AuthorizationJwt
Secret=nextcloud-aio-eurooffice-secret,type=env,target=JWT_SECRET

Volume=nextcloud-aio-eurooffice.volume:/var/lib/euro-office:rw,Z
Volume=nextcloud-aio-eurooffice-data.volume:/var/www/euro-office/Data:rw,Z

[Service]
Restart=always
TimeoutStartSec=900
