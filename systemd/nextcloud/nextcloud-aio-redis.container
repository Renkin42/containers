[Unit]
Description=Nextcloud AIO Redis

[Container]
Pod=nextcloud.pod
ContainerName=nextcloud-aio-redis
Image=ghcr.io/nextcloud-releases/aio-redis:latest
AutoUpdate=registry
User=999
RunInit=true

HealthCmd=/healthcheck.sh
HealthStartPeriod=0s
HealthStartupInterval=5s
HealthInterval=30s
HealthTimeout=30s
HealthRetries=3

Secret=nextcloud-aio-redis-password,type=env,target=REDIS_HOST_PASSWORD
Environment=AIO_LOG_LEVEL=warn
Environment=TZ=America/Los_Angeles

Volume=nextcloud-aio-redis.volume:/data:rw,Z
ReadOnly=true

[Service]
Restart=always
TimeoutStartSec=900
