[Unit]
Description=NextCloud Main Server
After=nextcloud-db.container
After=nextcloud-cache.container

[Container]
Pod=nextcloud.pod
ContainerName=nextcloud-main
Image=docker.io/library/nextcloud:latest
AutoUpdate=registry

Volume=nextcloud.volume:/var/www/html:Z
Volume=nextcloud-data.volume:/var/www/html/data:Z

Environment=NEXTCLOUD_ADMIN_USER=admin
Environment=NEXTCLOUD_ADMIN_PASSWORD_FILE=/run/secrets/nextcloud-admin-password
Environment=POSTGRES_HOST=localhost
Environment=POSTGRES_DB=nextcloud
Environment=POSTGRES_USER=nextcloud
Environment=POSTGRES_PASSWORD_FILE=/run/secrets/nextcloud-db-password
Environment=REDIS_HOST=localhost
Environment=PHP_UPLOAD_LIMIT=10G
Environment=APACHE_BODY_LIMIT=0
Environment=APACHE_DISABLE_REWRITE_IP=1
Environment=TRUSTED_PROXIES=172.23.0.0/16
Environment=NEXTCLOUD_TRUSTED_DOMAINS=cloud.wedomad.science

Secret=nextcloud-admin-password
Secret=nextcloud-db-password

[Service]
Restart=always
TimeoutStartSec=900
