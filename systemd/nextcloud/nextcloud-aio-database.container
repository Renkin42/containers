[Unit]
Descriotion=Nextcloud AIO Database

[Container]
Pod=nextcloud.pod
ContainerName=nextcloud-aio-database
Image=ghcr.io/nextcloud-releases/aio-postgresql:latest
AutoUpdate=registry
User=999
RunInit=true
StopTimeout=1800

HealthCmd=/healthcheck.sh
HealthStartPeriod=0s
HealthStartupInterval=5s
HealthInterval=30s
HealthTimeout=30s
HealthRetries=3

Environment=POSTGRES_DB=nextcloud_database
Environment=POSTGRES_USER=nextcloud
Environment=AIO_LOG_LEVEL=warn
Environment=TZ=America/Los_Angeles
Environment=PGTZ=America/Los_Angeles
Secret=nextcloud-aio-postgres-password,type=env,target=POSTGRES_PASSWORD

Volume=nextcloud-aio-database.volume:/var/lib/postgresql/data:rw,Z
Volume=nextcloud-aio-database-dump.volume:/mnt/data:rw,Z
ReadOnly=true
Tmpfs=/var/lib/postgresql
Tmpfs=/var/run/postgresql
ShmSize=268435456

[Service]
Restart=always
TimeoutStartSec=900
