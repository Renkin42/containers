[Unit]
Description=Nextcloud AIO Talk Server

[Container]
Pod=nextcloud.pod
ContainerName=nextcloud-aio-talk
Image=ghcr.io/nextcloud-releases/aio-talk:latest
AutoUpdate=registry
User=1000
RunInit=true

HealthCmd=/healthcheck.sh
HealthStartPeriod=0s
HealthStartupInterval=5s
HealthInterval=30s
HealthTimeout=30s
HealthRetries=3

Environment=NC_DOMAIN=cloud.wedomad.science
Environment=TALK_HOST=localhost
Secret=nextcloud-aio-turn-secret,type=env,target=TURN_SECRET
Secret=nextcloud-aio-signaling-secret,type=env,target=SIGNALING_SECRET
Environment=AIO_LOG_LEVEL=warn
Environment=TZ=America/Los_Angeles
Environment=TALK_PORT=3478
Secret=nextcloud-aio-talk-internal-secret,type=env,target=INTERNAL_SECRET

Volume=/usr/local/share/ca-certificates/my-custom-ca:/usr/local/share/ca-certificates:ro,z
ReadOnly=true
Tmpfs=/run
Tmpfs=/opt/eturnal/run
Tmpfs=/conf
Tmpfs=/tmp

[Service]
Restart=always
TimeoutStartSec=900
