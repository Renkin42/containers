[Unit]
Description=Nextcloud AIO Apache
After=nextcloud-aio-eurooffice.container
After=nextcloud-aio-notify-push.container
After=nextcloud-aio-talk.container
After=nextcloud-aio-nextcloud.container

[Container]
Pod=nextcloud.pod
ContainerName=nextcloud-aio-apache
Image=ghcr.io/nextcloud-releases/aio-apache:latest
AutoUpdate=registry
User=33
RunInit=true

HealthCmd=/healthcheck.sh
HealthStartPeriod=0s
HealthStartupInterval=5s
HealthInterval=30s
HealthTimeout=30s
HealthRetries=3

Environment=NC_DOMAIN=cloud.wedomad.science
Environment=NEXTCLOUD_HOST=localhost
Environment=APACHE_HOST=localhost
Environment=APACHE_PORT=11000
Environment=AIO_Log_level=warn
Environment=EUROOFFICE_HOST=localhost
Environment=TZ=America/Los_Angeles
Environment=APACHE_MAX_SIZE="1073741824"
Environment=APACHE_MAX_TIME=3600
Environment=NOTIFY_PUSH_HOST=localhost
Environment=TALK_HOST=localhost
Environment=HARP_HOST=localhost

Volume=nextcloud-aio-nextcloud.volume:/var/www/html:ro,Z
Volume=nextcloud-aio-apache.volume:/mnt/data:Z
ReadOnly=true
Tmpfs=/run
Tmpfs=/usr/local/apache2/logs
Tmpfs=/tmp
Tmpfs=/home/www-data

[Service]
Restart=always
TimeoutStartSec=900
