[Unit]
Description=Nextcloud AIO ElasticSearch

[Container]
Pod=nextcloud.pod
ContainerName=nextcloud-aio-fulltextsearch
Image=ghcr.io/nextcloud-releases/aio-fulltextsearch:latest
AutoUpdate=registry
RunInit=true

HealthCmd=/healthcheck.sh
HealthStartPeriod=60s
HealthStartupInterval=5s
HealthInterval=10s
HealthTimeout=5s
HealthRetries=5

Environment=AIO_LOG_LEVEL=warn
Environment=TZ=America/Los_Angeles
Environment=ES_JAVA_OPTS="-Xms512M -Xmx512M"
Environment=bootstrap.memory_lock=false
Environment=cluster.name=nextcloud-aio
Environment=discovery.type=single-node
Environment=http.port=9200
Environment=xpack.license.self_generated.type=basic
Environment=xpack.security.enabled=true
Environment=xpack.security.http.ssl.enabled=false
Environment=xpack.security.transport.ssl.enabled=false
Environment=indices.fielddata.cache.size=20%
Environment=indices.memory.index_buffer_size=20%
Environment=thread_pool.write.queue_size=1000
Secret=nextcloud-aio-fulltextsearch-password,type=env,target=ELASTIC_PASSWORD

Volume=nextcloud-aio-elasticsearch.volume:/usr/share/elasticsearch/data:rw,Z

[Service]
Restart=always
TimeoutStartSec=900
