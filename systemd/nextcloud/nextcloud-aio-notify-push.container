[Unit]
Description=Nextcloud AIO Notify Push

[Container]
Pod=nextcloud.pod
ContainerName=nextcloud-aio-notify-push
Image=ghcr.io/nextcloud-releases/aio-notify-push:latest
AutoUpdate=registry
User=33
RunInit=true

HealthCmd=/healthcheck.sh
HealthStartPeriod=0s
HealthStartupInterval=5s
HealthInterval=30s
HealthTimeout=30s
HealthRetries=3

Environment=NEXTCLOUD_HOST=localhost
Environment=AIO_LOG_LEVEL=warn
Environment=TZ=America/Los_Angeles

Volume=nextcloud-aio-nextcloud:/var/www/html:ro,z
Volume=/usr/local/share/ca-certificates/my-custom-ca:/usr/local/share/ca-certificates:ro,z
ReadOnly=true
Tmpfs=/tmp

[Service]
Resart=always
TimeoutStartSec=900
