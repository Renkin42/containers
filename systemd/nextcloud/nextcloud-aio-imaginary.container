[Unit]
Description=Nextcloud AIO Imaginary Thumbnail Generator

[Container]
Pod=nextcloud.pod
ContainerName=nextcloud-aio-imaginary
Image=ghcr.io/nextcloud-releases/aio-imaginary:latest
AutoUpdate=registry
User=65534
RunInit=true
AddCapability=SYS_NICE

HealthCmd=/healthcheck.sh
HealthStartPeriod=0s
HealthStartupInterval=5s
HealthInterval=30s
HealthTimeout=30s
HealthRetries=3

Environment=AIO_LOG_LEVEL=warn
Environment=TZ=America/Los_Angeles
Secret=nextcloud-aio-imaginary-secret,type=env,target=IMAGINARY_SECRET

ReadOnly=true
Tmpfs=/tmp

[Service]
Restart=always
TimeoutStartSec=900
