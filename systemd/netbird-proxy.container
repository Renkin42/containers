[Unit]
Description=Local Netbird Reverse Proxy

[Container]
ContainerName=netbird-proxy
Image=docker.io/netbirdio/reverse-proxy
AutoUpdate=Registry
Network=proxy.network
Volume=proxy-certs.volume:/certs:ro,z

Environment=NB_PROXY_CERTIFICATE_DIRECTORY=/certs
Environment=NB_PROXY_ALLOW_INSECURE=true
Environment=NB_PROXY_MANAGEMENT_ADDRESS=https://netbird.renkin42.dev
Environment=NB_PROXY_ACME_CERTIFICATES=false
Environment=NB_PROXY_DOMAIN=vpn.renkin42.dev
Environment=NB_PROXY_LOG_LEVEL=info
Environment=NB_PROXY_PRIVATE="true"
Environment=NB_PROXY_ADDRESS=":443"

Secret=nb-proxy-token,type=env,target=NB_PROXY_TOKEN

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=podman-start.target
