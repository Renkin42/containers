[Unit]
Description=Netbird Routing Peer for Traefik

[Container]
Pod=tunnel.pod
ContainerName=netbird-router
Image=docker.io/netbirdio/netbird:latest
AutoUpdate=registry

AddCapability=NET_ADMIN
AddCapability=NET_RAW

AddDevice=/dev/net/tun

Environment=NB_MANAGEMENT_URL=https://netbird.renkin42.dev

Volume=nbrouter.volume:/var/lib/netbird:Z,U

Secret=nb-router-key,type=env,target=NB_SETUP_KEY

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=podman-start.target
