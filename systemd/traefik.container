[Unit]
Description=Traefik Reverse Proxy

[Container]
Pod=tunnel.pod
ContainerName=traefik
Image=docker.io/library/traefik:latest
AutoUpdate=registry
SecurityLabelDisable=true

Volume=/etc/containers/configs/traefik.yaml:/etc/traefik/traefik.yaml:ro,z
Volume=/var/run/podman/podman.sock:/var/run/docker.sock:ro

Secret=renkin42-dev-cert,target=renkin42.dev.pem
Secret=renkin42-dev-key,target=renkin42.dev.key

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=podman-start.target
