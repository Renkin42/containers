[Unit]
Description=Traefik Reverse Proxy

[Container]
Pod=tunnel.pod
ContainerName=traefik
Image=docker.io/library/traefik:latest
AutoUpdate=registry
SecurityLabelDisable=true

Environment=CLOUDFLARE_API_KEY_FILE=/run/secrets/cloudflare-cert-token

Volume=/etc/containers/configs/traefik.yaml:/etc/traefik/traefik.yaml:ro,z
Volume=/var/run/podman/podman.sock:/var/run/docker.sock:ro
Volume=proxy-certs.volume:/letsencrypt:Z,U

Secret=cloudflare-cert-token

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=podman-start.target
